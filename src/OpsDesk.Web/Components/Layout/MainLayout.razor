@inherits LayoutComponentBase
@implements IDisposable
@inject RoleState RoleState
@inject NotificationState NotificationState
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid #334155;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-1">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="28" height="28" rx="7" fill="#10B981" fill-opacity="0.16" stroke="#10B981" stroke-width="1.5" />
                <path d="M8 14.5L12 18.5L20 10" stroke="#10B981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.02em;">OpsDesk</MudText>
        </MudStack>

        <MudSpacer />

        @if (RoleState.IsOperationalStaff)
        {
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Placeholder="Search tickets, IDs, or assignees..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          OnKeyDown="HandleSearchKeyDown"
                          Class="mx-4 d-none d-md-flex ops-search-input"
                          Style="max-width: 320px; background-color: #0F172A;" />
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mr-3 px-2 py-1"
                  Style="background: #1E293B; border-radius: 8px; border: 1px solid #334155;">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="font-size: 0.65rem; height: 20px;">
                PERSONA
            </MudChip>
            <MudSelect T="WorkspaceRole"
                       Value="RoleState.CurrentRole"
                       ValueChanged="OnRoleChanged"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Text"
                       Style="min-width: 165px; font-size: 0.8125rem;">
                <MudSelectItem T="WorkspaceRole" Value="WorkspaceRole.OperationsLead">Operations Lead</MudSelectItem>
                <MudSelectItem T="WorkspaceRole" Value="WorkspaceRole.TriageLead">Triage Lead</MudSelectItem>
                <MudSelectItem T="WorkspaceRole" Value="WorkspaceRole.Specialist">Specialist</MudSelectItem>
                <MudSelectItem T="WorkspaceRole" Value="WorkspaceRole.Requester">Requester</MudSelectItem>
                <MudSelectItem T="WorkspaceRole" Value="WorkspaceRole.Admin">System Admin</MudSelectItem>
            </MudSelect>
        </MudStack>

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" MaxHeight="420">
            <ActivatorContent>
                <MudBadge Content="@NotificationState.UnreadCount"
                          Visible="@(NotificationState.UnreadCount > 0)"
                          Color="Color.Error"
                          Overlap="true"
                          Class="mr-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                   Color="Color.Inherit"
                                   aria-label="Notifications"
                                   OnClick="@context.ToggleAsync" />
                </MudBadge>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 py-2 d-flex align-center justify-space-between" style="min-width: 320px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Notifications</MudText>
                        @if (NotificationState.UnreadCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Style="height: 20px; font-size: 0.7rem;">
                                @NotificationState.UnreadCount unread
                            </MudChip>
                        }
                    </MudStack>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Disabled="@(NotificationState.UnreadCount == 0)"
                               OnClick="@(() => NotificationState.MarkAllRead())">
                        Mark all read
                    </MudButton>
                </div>
                <MudDivider />
                @if (NotificationState.Alerts.Count == 0)
                {
                    <div class="px-4 py-4 text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">You're all caught up.</MudText>
                    </div>
                }
                else
                {
                    @foreach (var alert in NotificationState.Alerts.Take(5))
                    {
                        <MudMenuItem OnClick="@(() => OpenAlert(alert))">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Style="max-width: 300px;">
                                <MudIcon Icon="@alert.Icon" Color="alert.Color" Size="Size.Small" Class="mt-1" />
                                <div style="min-width: 0; flex: 1;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                        <MudText Typo="Typo.body2" Style="@(alert.IsRead ? "font-weight: 400;" : "font-weight: 600;")">
                                            @alert.Title
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="ops-mono" Color="Color.Primary">@alert.TicketId</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal;">
                                        @alert.Message
                                    </MudText>
                                </div>
                                @if (!alert.IsRead)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Primary" Style="font-size: 8px; margin-top: 6px;" />
                                }
                            </MudStack>
                        </MudMenuItem>
                    }
                }
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.NotificationsActive" Href="/notifications">
                    View all notifications
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="px-2" OnClick="@context.ToggleAsync">
                    <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2" Style="color: #042F2E; font-weight: 700;">
                        @RoleState.CurrentInitials
                    </MudAvatar>
                    <div class="d-none d-sm-flex flex-column text-left">
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@RoleState.CurrentDisplayName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.1;">@RoleState.CurrentRoleName</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="ml-1" />
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 py-2" style="min-width: 220px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@RoleState.CurrentDisplayName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@RoleState.CurrentEmail</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="height: 20px; font-size: 0.7rem;">
                            @RoleState.CurrentRoleName
                        </MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@RoleState.CurrentDepartment</MudText>
                    </MudStack>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/my-requests">My Requests</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.PostAdd" Href="/submit">Submit Request</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Notifications" Href="/notifications">Notification Center</MudMenuItem>
                @if (RoleState.CanAccessAdmin)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" Href="/admin/roles">Admin &amp; Roles</MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive"
               Style="border-right: 1px solid #334155;">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-20 pb-10 px-4 px-md-8" Style="background-color: #0F172A; min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string? _searchText;
    private readonly MudTheme _theme = OpsDeskTheme.CreateTheme();

    protected override async Task OnInitializedAsync()
    {
        RoleState.OnChange += StateHasChanged;
        NotificationState.OnChange += StateHasChanged;
        await NotificationState.EnsureLoadedAsync(Mediator);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RoleState.InitializeAsync();
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task OnRoleChanged(WorkspaceRole newRole)
    {
        await RoleState.SetRoleAsync(newRole);
        Snackbar.Add($"Switched active persona to {RoleState.CurrentDisplayName} ({RoleState.CurrentRoleName})", Severity.Info);

        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (newRole == WorkspaceRole.Requester && string.IsNullOrEmpty(relativePath))
        {
            Navigation.NavigateTo("/my-requests");
        }
    }

    private void OpenAlert(NotificationItem alert)
    {
        NotificationState.MarkAsRead(alert);
        Navigation.NavigateTo($"/tickets/{alert.TicketId}");
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchText))
        {
            Navigation.NavigateTo($"/tickets?search={Uri.EscapeDataString(_searchText.Trim())}");
        }
    }

    public void Dispose()
    {
        RoleState.OnChange -= StateHasChanged;
        NotificationState.OnChange -= StateHasChanged;
    }
}
