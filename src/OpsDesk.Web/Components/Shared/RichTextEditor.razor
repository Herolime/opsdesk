@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="quill-custom-wrapper">
    @if (ToolbarContent != null)
    {
        <div class="@ToolbarCssClass" @ref="_toolbarElement">
            @ToolbarContent
        </div>
    }
    <div class="@EditorCssClass" @ref="_editorElement"></div>
</div>

@code {
    private ElementReference _editorElement;
    private ElementReference _toolbarElement;
    private IJSObjectReference? _module;

    [Parameter] public RenderFragment? ToolbarContent { get; set; }
    [Parameter] public string? Content { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Theme { get; set; } = "snow";
    [Parameter] public string EditorCssClass { get; set; } = "ops-rte-compact";
    [Parameter] public string ToolbarCssClass { get; set; } = "quill-custom-toolbar";

    private async ValueTask<IJSObjectReference> GetModuleAsync() =>
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Shared/RichTextEditor.razor.js");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await GetModuleAsync();
            await module.InvokeVoidAsync(
                "createQuill",
                _editorElement,
                ToolbarContent != null ? _toolbarElement : null,
                ReadOnly,
                Placeholder,
                Theme,
                Content);
        }
    }

    public async Task<string> GetHTMLAsync()
    {
        var module = await GetModuleAsync();
        var html = await module.InvokeAsync<string>("getHTML", _editorElement) ?? string.Empty;
        return html.Trim() == "<p><br></p>" ? string.Empty : html;
    }

    public async Task LoadHTMLContentAsync(string? htmlContent)
    {
        Content = htmlContent;
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("loadHTMLContent", _editorElement, htmlContent ?? string.Empty);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _editorElement);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }
}
