<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Approve &amp; Close Ticket</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Confirm final approval and optionally add a closing resolution summary.
        </MudText>
        <MudTextField T="string" @bind-Value="_summary" Label="Closing Resolution Summary (Optional)"
                      Lines="3" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Style="color: #042F2E; font-weight: 700;">
            Approve &amp; Resolve
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string? _summary;

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(_summary?.Trim() ?? string.Empty));
}
