@page "/not-found"

<PageTitle>Not Found — OpsDesk</PageTitle>

<MudPaper Class="pa-8 ops-card text-center" Elevation="0">
    <MudText Typo="Typo.h3" Color="Color.Primary">404</MudText>
    <MudText Typo="Typo.h6" Class="mt-2">Page Not Found</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-4">
        The requested route does not exist in this workspace.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Style="color: #042F2E; font-weight: 700;">
        Return to Overview
    </MudButton>
</MudPaper>
