@page "/my-requests"
@implements IDisposable
@inject IMediator Mediator
@inject RoleState RoleState
@inject NavigationManager Navigation

<PageTitle>My Requests — OpsDesk</PageTitle>

<MudStack Spacing="5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h4">My Requests</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Viewing service requests submitted by <strong style="color: #F8FAFC;">@RoleState.CurrentDisplayName</strong> (@RoleState.CurrentEmail)
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/submit" Style="color: #042F2E; font-weight: 700;">
            + New Service Request
        </MudButton>
    </MudStack>

    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 ops-card" Elevation="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL SUBMITTED</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_tickets.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 ops-card" Elevation="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">OPEN / TRIAGE</MudText>
                <MudText Typo="Typo.h4" Class="mt-1" Color="Color.Info">@_tickets.Count(t => t.Status == "Open")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 ops-card" Elevation="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">IN PROGRESS</MudText>
                <MudText Typo="Typo.h4" Class="mt-1" Color="Color.Secondary">@_tickets.Count(t => t.Status is "InProgress" or "PendingReview")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 ops-card" Elevation="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">RESOLVED</MudText>
                <MudText Typo="Typo.h4" Class="mt-1" Color="Color.Success">@_tickets.Count(t => t.Status == "Resolved")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_tickets.Any(t => t.IsAtRisk || t.IsOverdue))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Schedule">
            You have @_tickets.Count(t => t.IsAtRisk || t.IsOverdue) active request(s) approaching or past their target SLA window.
        </MudAlert>
    }

    <MudPaper Class="pa-5 ops-card" Elevation="0">
        <MudStack Row="true" Spacing="3" Class="mb-4 flex-wrap" AlignItems="AlignItems.Center">
            <MudTextField T="string" @bind-Value="_search" Placeholder="Filter by ID or title..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Style="max-width: 280px;" />
            <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 180px;">
                <MudSelectItem Value="@("")">All Statuses</MudSelectItem>
                <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                <MudSelectItem Value="@("InProgress")">In Progress</MudSelectItem>
                <MudSelectItem Value="@("PendingReview")">Pending Review</MudSelectItem>
                <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
            </MudSelect>
        </MudStack>

        <MudTable Items="FilteredTickets" Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
            <HeaderContent>
                <MudTh>Ticket ID</MudTh>
                <MudTh>Request Title</MudTh>
                <MudTh>Service Stream</MudTh>
                <MudTh>Assigned Specialist</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Target SLA</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudText Typo="Typo.body2" Class="ops-mono" Color="Color.Primary">@context.Id</MudText></MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Title</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Category • @context.Environment</MudText>
                </MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.ServiceStream</MudChip></MudTd>
                <MudTd>@(context.AssignedSpecialist ?? "Pending Triage")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="UiHelpers.StatusColor(context.Status)" Variant="Variant.Filled">
                        @UiHelpers.StatusLabel(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd>@context.TatDueDate.ToString("MMM dd, yyyy")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => Navigation.NavigateTo($"/tickets/{context.Id}"))">
                        View Details
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                    No requests found for @RoleState.CurrentDisplayName. Switch to the Requester persona or submit a new request.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private List<TicketSummaryDto> _tickets = new();
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;

    private IEnumerable<TicketSummaryDto> FilteredTickets => _tickets.Where(t =>
        (string.IsNullOrWhiteSpace(_search) ||
         t.Id.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_statusFilter) || t.Status == _statusFilter));

    protected override async Task OnInitializedAsync()
    {
        RoleState.OnChange += HandleRoleChanged;
        await LoadTicketsAsync();
    }

    private async void HandleRoleChanged()
    {
        await LoadTicketsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadTicketsAsync()
    {
        var result = await Mediator.Send(new GetTicketsQuery(
            RequesterEmail: RoleState.CurrentRole == WorkspaceRole.Requester ? RoleState.CurrentEmail : null,
            PageSize: 50));
        _tickets = result.Items;
    }

    public void Dispose() => RoleState.OnChange -= HandleRoleChanged;
}
