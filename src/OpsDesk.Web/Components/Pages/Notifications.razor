@page "/notifications"
@inject OpsDesk.Application.Common.Interfaces.INotificationRepository NotificationRepo
@inject NavigationManager Navigation

<PageTitle>Notification Center — OpsDesk</PageTitle>

<MudStack Spacing="5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h4">Notification Center</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Real-time SLA warnings, triage assignments, return-with-feedback alerts, and approvals.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="MarkAllReadAsync">
            Mark All as Read
        </MudButton>
    </MudStack>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">
                @if (_alerts.Count == 0)
                {
                    <MudPaper Class="pa-6 ops-card text-center" Elevation="0">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No notifications yet.</MudText>
                    </MudPaper>
                }
                @foreach (var alert in _alerts)
                {
                    <MudPaper Class="@(alert.IsRead ? "pa-4 ops-card" : "pa-4 ops-selected-card")" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                                <MudIcon Icon="@IconFor(alert.Category)" Color="@ColorFor(alert.Category)" Class="mt-1" />
                                <div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@alert.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Class="ops-mono" Variant="Variant.Outlined" Color="Color.Primary">
                                            @alert.TicketId
                                        </MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@alert.Message</MudText>
                                </div>
                            </MudStack>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       OnClick="@(() => OpenTicketAsync(alert))">
                                Open
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Class="ops-card" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Alert Preferences</MudText>
                    <MudStack Spacing="2">
                        <MudSwitch T="bool" @bind-Value="_slaAlerts" Label="In-App SLA Breach Alerts" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="_assignAlerts" Label="Assignment Notifications" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="_mentionAlerts" Label="Direct Mentions" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="_digestAlerts" Label="Daily Operations Digest" Color="Color.Primary" />
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private bool _slaAlerts = true;
    private bool _assignAlerts = true;
    private bool _mentionAlerts = true;
    private bool _digestAlerts = false;
    private List<Notification> _alerts = new();

    protected override async Task OnInitializedAsync() =>
        _alerts = await NotificationRepo.GetRecentAsync(limit: 40);

    private async Task OpenTicketAsync(Notification alert)
    {
        if (!alert.IsRead)
            await NotificationRepo.MarkAsReadAsync(alert.Id);
        Navigation.NavigateTo($"/tickets/{alert.TicketId}");
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationRepo.MarkAllAsReadAsync();
        foreach (var a in _alerts) a.IsRead = true;
    }

    private static string IconFor(string category) => category switch
    {
        "Returned" => Icons.Material.Filled.Reply,
        "Approval" => Icons.Material.Filled.VerifiedUser,
        "Resolved" => Icons.Material.Filled.CheckCircleOutline,
        "SLA" => Icons.Material.Filled.WarningAmber,
        _ => Icons.Material.Filled.Notifications
    };

    private static Color ColorFor(string category) => category switch
    {
        "Returned" => Color.Warning,
        "Approval" => Color.Tertiary,
        "Resolved" => Color.Success,
        "SLA" => Color.Error,
        _ => Color.Info
    };
}
